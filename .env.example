# Backend manzili. Swagger: <VITE_API_URL>/api/docs
VITE_API_URL=http://localhost:3000

# Production uchun bu qiymat `.env.production` da bo'lishi kerak (u `.gitignore` da):
#
#   echo 'VITE_API_URL=https://api.ocomarket.uz' > .env.production
#
# Vite env ni BUILD PAYTIDA kodga singdiradi — noto'g'ri qiymat bilan yig'ilgan
# `dist/` ni keyin tuzatib bo'lmaydi. Batafsil: docs/deploy.md
